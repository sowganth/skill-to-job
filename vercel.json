{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend" },
    { "source": "/index.html", "destination": "/frontend" },
    { "source": "/login", "destination": "/frontend/login" },
    { "source": "/login.html", "destination": "/frontend/login" },
    { "source": "/register", "destination": "/frontend/register" },
    { "source": "/register.html", "destination": "/frontend/register" },
    { "source": "/dashboard", "destination": "/frontend/dashboard" },
    { "source": "/dashboard.html", "destination": "/frontend/dashboard" },
    { "source": "/jobs", "destination": "/frontend/jobs" },
    { "source": "/jobs.html", "destination": "/frontend/jobs" },
    { "source": "/job-details", "destination": "/frontend/job-details" },
    { "source": "/job-details.html", "destination": "/frontend/job-details" },
    { "source": "/profile", "destination": "/frontend/profile" },
    { "source": "/profile.html", "destination": "/frontend/profile" },
    { "source": "/skills", "destination": "/frontend/skills" },
    { "source": "/skills.html", "destination": "/frontend/skills" },
    { "source": "/skill-gap", "destination": "/frontend/skill-gap" },
    { "source": "/skill-gap.html", "destination": "/frontend/skill-gap" },
    { "source": "/learning-resources", "destination": "/frontend/learning-resources" },
    { "source": "/learning-resources.html", "destination": "/frontend/learning-resources" },
    { "source": "/css/:path*", "destination": "/frontend/css/:path*" },
    { "source": "/js/:path*", "destination": "/frontend/js/:path*" },
    { "source": "/src/:path*", "destination": "/frontend/src/:path*" }
  ]
}
